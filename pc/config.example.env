# Copy to ~/.config/claude-telegram-central/pc.env (or point CENTRAL_PC_CONFIG at another path).
# Environment variables with the same names take priority. Never commit the real file.

# SSH access to the server that runs server/central.py (key-based, no password prompt).
CENTRAL_SSH_HOST=<user>@<server-host>
CENTRAL_SSH_KEY=~/.ssh/<your-private-key>

# Where the server code and data live, relative to the remote home directory (these are the defaults).
CENTRAL_REMOTE_CODE=claude-telegram-central/server
CENTRAL_REMOTE_DATA=claude-telegram-central/data

# Where attachments land on this PC (default: <data dir>/downloads).
# CENTRAL_DOWNLOAD_DIR=<folder>

# Notices to Telegram. Easiest and safest when the server runs a local Bot API server:
# route them through the server, so no token is needed on the PC.
TELEGRAM_VIA_SERVER=1
# Otherwise leave the line above out and set these (the token then lives on the PC too):
# TELEGRAM_TOKEN=<your-bot-token>
# TELEGRAM_CHAT_ID=<your-chat-id>

# Not here on purpose: CENTRAL_DATA_DIR. It is read from the environment only
# (default ~/.claude-telegram-central), so the hook and the watcher always agree on it.
