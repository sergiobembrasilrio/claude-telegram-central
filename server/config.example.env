# Copy to ~/.config/claude-telegram-central/telegram.env and run: chmod 600 telegram.env
# (or point CENTRAL_CONFIG at another path). Never commit the real file.

# From @BotFather
TELEGRAM_TOKEN=<your-bot-token>
# Your own numeric chat id. Only this chat is served; every other chat is refused.
TELEGRAM_CHAT_ID=<your-chat-id>

# Optional: a local Bot API server (files up to 2 GB). setup_local_bot_api.sh writes this line for you.
# TELEGRAM_API=http://127.0.0.1:8081
